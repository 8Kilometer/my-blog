---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GlassNav from '../../components/GlassNav.astro';
import PostCard from '../../components/PostCard.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [...new Set(posts.map((p) => p.data.category))];

// 序列化到客户端
const searchData = posts.map((p) => ({
  slug: p.slug,
  title: p.data.title,
  pubDate: p.data.pubDate.toISOString(),
  description: p.data.description,
  category: p.data.category,
  tags: p.data.tags,
  coverImage: p.data.coverImage,
}));
---

<BaseLayout title="全部文章" description="所有笔触">
  <GlassNav />
  <main style="padding-top:120px;">
    <section>
      <div class="wrap">
        <div class="sec-head">
          <div class="tag">All Strokes</div>
          <h2>全部文章</h2>
          <div class="line"></div>
        </div>

        <!-- 搜索框 -->
        <div class="search-box">
          <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input type="text" class="search-input" id="searchInput" placeholder="搜索文章标题、描述、标签…" />
        </div>

        <!-- 分类标签 -->
        <div class="cats" id="categoryChips">
          <a href="#posts" class="chip active" data-cat="all">全部 <em>{posts.length}</em></a>
          {categories.map((c) => (
            <span class="chip" data-cat={c}>{c}</span>
          ))}
        </div>

        <div class="grid grid--3" id="posts">
          {posts.map((post) => (
            <PostCard
              title={post.data.title}
              pubDate={post.data.pubDate}
              description={post.data.description}
              category={post.data.category}
              coverImage={post.data.coverImage}
              href={`/blog/${post.slug}/`}
            />
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script define:vars={{ searchData }}>
  const postsData = searchData;
  const grid = document.getElementById('posts');
  const searchInput = document.getElementById('searchInput');
  const chips = document.querySelectorAll('#categoryChips .chip');

  let activeCat = 'all';

  // 分类切换
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.remove('active'));
      chip.classList.add('active');
      activeCat = chip.dataset.cat;
      filter();
    });
  });

  // 搜索过滤
  searchInput.addEventListener('input', filter);

  function filter() {
    const q = searchInput.value.trim().toLowerCase();
    const matched = postsData.filter((p) => {
      if (activeCat !== 'all' && p.category !== activeCat) return false;
      if (!q) return true;
      return (
        p.title.toLowerCase().includes(q) ||
        p.description.toLowerCase().includes(q) ||
        p.category.toLowerCase().includes(q) ||
        p.tags.some((t) => t.toLowerCase().includes(q))
      );
    });
    render(matched);
  }

  function render(list) {
    if (list.length === 0) {
      grid.innerHTML = `<div class="search-empty">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.4;margin-bottom:12px">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          <line x1="8" y1="11" x2="14" y2="11"/>
        </svg>
        <p>没有找到相关文章</p>
        <span>换个关键词试试</span>
      </div>`;
      return;
    }
    grid.innerHTML = list
      .map(
        (p) => `
      <a class="post" href="/blog/${p.slug}/">
        <div class="post-thumb">
          ${p.coverImage ? `<img src="${p.coverImage}" alt="${p.title}" loading="lazy" />` : `<div class="post-thumb-empty">🎨</div>`}
        </div>
        <div class="post-body">
          <div class="post-meta">
            <span class="cat">${p.category}</span>
            <span class="date">${new Date(p.pubDate).toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '.')}</span>
          </div>
          <h3>${p.title}</h3>
          <p>${p.description}</p>
          <span class="more">阅读全文 →</span>
        </div>
      </a>`
      )
      .join('');
  }
</script>

<style>
  section { padding: 24px 0 96px; }
  .grid--3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .cats {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 44px;
  }
  .chip {
    padding: 9px 18px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255,255,255,0.7);
    font-size: 13px;
    color: var(--ink-soft);
    backdrop-filter: blur(8px);
    cursor: pointer;
    transition: background 0.25s, color 0.25s;
  }
  .chip em { font-style: normal; opacity: 0.6; margin-left: 2px; }
  .chip.active {
    background: var(--terracotta);
    color: #f4f8ff;
    border-color: transparent;
  }

  /* 搜索框 */
  .search-box {
    position: relative;
    max-width: 560px;
    margin: 0 auto 40px;
  }
  .search-icon {
    position: absolute;
    left: 20px; top: 50%;
    transform: translateY(-50%);
    width: 20px; height: 20px;
    color: var(--accent-deep);
    pointer-events: none;
  }
  .search-input {
    width: 100%;
    padding: 15px 20px 15px 54px;
    border-radius: 999px;
    font-size: 15px;
    color: var(--ink);
    background: var(--glass);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border: 1px solid var(--glass-border);
    box-shadow: 0 10px 30px rgba(30, 50, 110, 0.12);
    outline: none;
    transition: box-shadow 0.3s, border-color 0.3s;
  }
  .search-input::placeholder { color: var(--ink-soft); opacity: 0.7; }
  .search-input:focus {
    border-color: var(--accent);
    box-shadow: 0 14px 40px rgba(60, 110, 220, 0.24);
  }

  /* 搜索空状态 */
  .search-empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 80px 0;
    color: var(--ink-soft);
  }
  .search-empty p { font-family: var(--font-serif); font-size: 18px; color: var(--ink); margin-bottom: 6px; }
  .search-empty span { font-size: 13px; opacity: 0.6; }
</style>