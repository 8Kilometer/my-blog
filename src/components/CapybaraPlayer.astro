---
import fs from 'node:fs';
import path from 'node:path';

// 构建时扫描 public/music 目录，自动生成播放列表
const musicDir = path.join(process.cwd(), 'public', 'music');
const audioExt = /\.(mp3|wav|ogg|m4a|flac|aac)$/i;
let localTracks = [];
if (fs.existsSync(musicDir)) {
  localTracks = fs
    .readdirSync(musicDir)
    .filter((f) => audioExt.test(f))
    .sort((a, b) => a.localeCompare(b, 'zh'))
    .map((f) => ({
      name: f.replace(audioExt, ''),
      url: '/music/' + f,
    }));
}
---

<div class="mp-wrap">
  <!-- 当前播放信息 -->
  <div class="mp-now">
    <div class="mp-marquee"><span id="mpTitle">{localTracks.length > 0 ? localTracks[0].name : '把音乐放到 public/music 文件夹'}</span></div>
    <div class="mp-time"><span id="mpCur">00:00</span><span id="mpDur">00:00</span></div>
  </div>

  <!-- 进度条 -->
  <div class="mp-progress" id="mpBar">
    <div class="mp-fill" id="mpFill"></div>
  </div>

  <!-- 控制按钮 -->
  <div class="mp-controls">
    <button class="mp-btn" id="mpPrev" title="上一首" disabled>⏮</button>
    <button class="mp-btn mp-play" id="mpPlay" title="播放/暂停" disabled>▶</button>
    <button class="mp-btn" id="mpNext" title="下一首" disabled>⏭</button>
    <button class="mp-btn" id="mpVol" title="静音">🔊</button>
  </div>

  <!-- 本地播放列表 -->
  <div class="mp-list {localTracks.length > 1 ? 'show' : ''}" id="mpList">
    {localTracks.map((t, i) => (
      <div class="mp-item {i === 0 ? 'active' : ''}" data-index={i}>{i + 1}. {t.name}</div>
    ))}
  </div>
</div>

<style>
  .mp-wrap {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 60;
    width: 280px;
    padding: 16px 18px;
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow);
  }

  .mp-now { margin-bottom: 10px; }
  .mp-marquee {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 4px;
  }
  .mp-time {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--ink-soft);
  }

  .mp-progress {
    height: 6px;
    border-radius: 999px;
    background: rgba(41, 98, 235, 0.12);
    cursor: pointer;
    overflow: hidden;
    margin-bottom: 14px;
  }
  .mp-fill {
    height: 100%;
    width: 0%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--accent), var(--accent-deep));
    transition: width 0.15s linear;
  }

  .mp-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  .mp-btn {
    width: 38px; height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid rgba(41, 98, 235, 0.25);
    background: rgba(255, 255, 255, 0.7);
    color: var(--accent-deep);
    font-size: 14px;
    cursor: pointer;
    transition: background 0.25s, transform 0.2s;
  }
  .mp-btn:hover:not(:disabled) { background: var(--accent-deep); color: #fff; transform: translateY(-2px); }
  .mp-btn:disabled { opacity: 0.35; cursor: not-allowed; }
  .mp-play { width: 46px; height: 46px; font-size: 16px; }

  .mp-list {
    margin-top: 12px;
    max-height: 130px;
    overflow-y: auto;
    display: none;
    flex-direction: column;
    gap: 3px;
  }
  .mp-list.show { display: flex; }
  .mp-item {
    font-size: 12px;
    color: var(--ink-soft);
    padding: 5px 10px;
    border-radius: 8px;
    cursor: pointer;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mp-item:hover { background: rgba(41, 98, 235, 0.1); color: var(--accent-deep); }
  .mp-item.active { color: var(--accent-deep); font-weight: 600; }

  @media (max-width: 640px) {
    .mp-wrap { right: 14px; bottom: 14px; left: 14px; width: auto; }
  }
</style>

<script define:vars={{ localTracks }} data-astro-rerun>
  const tracks = localTracks;

  // ===== 全站持久音频单例 =====
  if (!window.__mp) {
    window.__mp = {
      audio: new Audio(),
      current: -1,
      dom: null,   // 当前页面的 DOM 引用
      init: false, // 事件是否已绑定一次
    };
  }
  const mp = window.__mp;
  const audio = mp.audio;

  // ===== 收集当前页面 DOM =====
  mp.dom = {
    titleEl: document.getElementById('mpTitle'),
    curEl: document.getElementById('mpCur'),
    durEl: document.getElementById('mpDur'),
    barEl: document.getElementById('mpBar'),
    fillEl: document.getElementById('mpFill'),
    playBtn: document.getElementById('mpPlay'),
    prevBtn: document.getElementById('mpPrev'),
    nextBtn: document.getElementById('mpNext'),
    volBtn: document.getElementById('mpVol'),
    listEl: document.getElementById('mpList'),
  };

  const fmt = (t) =>
    !isFinite(t) || t < 0 ? '00:00' : String(Math.floor(t / 60)).padStart(2, '0') + ':' + String(Math.floor(t % 60)).padStart(2, '0');

  function highlight() {
    mp.dom.listEl.querySelectorAll('.mp-item').forEach((it) => {
      it.classList.toggle('active', Number(it.dataset.index) === mp.current);
    });
  }

  function playAt(i) {
    if (i < 0 || i >= tracks.length) return;
    mp.current = i;
    audio.src = tracks[i].url;
    audio.play();
    mp.dom.titleEl.textContent = tracks[i].name;
    highlight();
  }

  function togglePlay() {
    if (tracks.length === 0) return;
    if (mp.current === -1) { playAt(0); return; }
    audio.paused ? audio.play() : audio.pause();
  }

  // 本地列表点击（每次导航重新绑定到当前 DOM）
  mp.dom.listEl.querySelectorAll('.mp-item').forEach((it) => {
    it.addEventListener('click', () => playAt(Number(it.dataset.index)));
  });
  mp.dom.playBtn.addEventListener('click', togglePlay);
  mp.dom.prevBtn.addEventListener('click', () => { if (mp.current > 0) playAt(mp.current - 1); });
  mp.dom.nextBtn.addEventListener('click', () => { if (tracks.length) playAt((mp.current + 1) % tracks.length); });
  mp.dom.volBtn.addEventListener('click', () => {
    audio.muted = !audio.muted;
    mp.dom.volBtn.textContent = audio.muted ? '🔇' : '🔊';
  });
  mp.dom.barEl.addEventListener('click', (e) => {
    if (!audio.duration) return;
    const rect = mp.dom.barEl.getBoundingClientRect();
    audio.currentTime = ((e.clientX - rect.left) / rect.width) * audio.duration;
  });

  // ===== 全局事件只绑定一次 =====
  if (!mp.init) {
    mp.init = true;
    audio.addEventListener('play', () => { if (mp.dom) mp.dom.playBtn.textContent = '❚❚'; });
    audio.addEventListener('pause', () => { if (mp.dom) mp.dom.playBtn.textContent = '▶'; });
    audio.addEventListener('ended', () => {
      if (tracks.length && mp.dom) playAt((mp.current + 1) % tracks.length);
    });
    audio.addEventListener('timeupdate', () => {
      if (!mp.dom) return;
      mp.dom.curEl.textContent = fmt(audio.currentTime);
      if (audio.duration) {
        mp.dom.durEl.textContent = fmt(audio.duration);
        mp.dom.fillEl.style.width = (audio.currentTime / audio.duration) * 100 + '%';
      }
    });
    audio.addEventListener('loadedmetadata', () => { if (mp.dom) mp.dom.durEl.textContent = fmt(audio.duration); });
  }

  // ===== 导航回显：恢复曲目、播放状态与进度 =====
  function updateControls() {
    const has = tracks.length > 0;
    mp.dom.playBtn.disabled = !has;
    mp.dom.prevBtn.disabled = !has || mp.current <= 0;
    mp.dom.nextBtn.disabled = !has;
  }
  updateControls();

  if (mp.current >= 0 && mp.current < tracks.length) {
    mp.dom.titleEl.textContent = tracks[mp.current].name;
    highlight();
    mp.dom.playBtn.textContent = audio.paused ? '▶' : '❚❚';
    if (audio.duration) {
      mp.dom.fillEl.style.width = (audio.currentTime / audio.duration) * 100 + '%';
      mp.dom.curEl.textContent = fmt(audio.currentTime);
      mp.dom.durEl.textContent = fmt(audio.duration);
    }
  }
</script>
